# ─── PostgreSQL Database (Compatible with Supabase Transaction Pooler & IPv6) ───
# For Supabase Transaction Pooler (port 6543, recommended for Vercel / serverless):
# Format: postgresql://postgres.[REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/outbid

# Direct connection (port 5432) for running migrations, schema pushes, and seed:
# Format: postgresql://postgres.[REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres
DATABASE_DIRECT_URL=postgresql://postgres:postgres@127.0.0.1:5432/outbid

# Database SSL configuration (true for Supabase / cloud, false for local Docker)
DATABASE_SSL=false

# ─── Dodo Payments (Merchant of Record) ───
# Get your API keys at: https://app.dodopayments.com (or test.dodopayments.com)
# Leave empty or set to mock_... for local zero-config sandbox testing
DODO_PAYMENTS_API_KEY=test_your_dodo_api_key_here

# Webhook Secret from Dodo Payments Dashboard -> Developers -> Webhooks
DODO_PAYMENTS_WEBHOOK_SECRET=whsec_your_dodo_webhook_secret_here

# Environment: 'test' for sandbox testing, 'live' for real payments
DODO_PAYMENTS_ENVIRONMENT=test

# Product ID from Dodo Payments Dashboard -> Products
DODO_PAYMENTS_PRODUCT_ID=pdt_your_product_id_here

# ─── Brevo (Sendinblue) Transactional Emails ───
# Get your free API key at: https://app.brevo.com/settings/keys/api
# Leave empty for dev mode (verification codes will print directly to the server terminal)
BREVO_API_KEY=xkeysib-your_brevo_api_key_here
BREVO_SENDER_EMAIL=notifications@getopfloor.com
BREVO_SENDER_NAME=GeTopFloor

# Session signature secret
SESSION_SECRET=your_random_secret_for_floor_management_sessions

# ─── Admin Panel Credentials ───
ADMIN_EMAIL=admin@getopfloor.com
ADMIN_PASSWORD=your_secure_admin_password_here

# Server Port (default: 3000)
PORT=3000
